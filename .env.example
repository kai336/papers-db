# Database Connection
# For local development, use a local MongoDB instance
# For production (Cloudflare Pages), use MongoDB Atlas
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/papers-db?retryWrites=true&w=majority"

# Optional: Cloudflare R2 configuration (for file uploads in production)
# R2_ACCOUNT_ID="your-account-id"
# R2_ACCESS_KEY_ID="your-access-key"
# R2_SECRET_ACCESS_KEY="your-secret-key"
# R2_BUCKET_NAME="papers-pdfs"
